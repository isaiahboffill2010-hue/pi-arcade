{
  "name": "pi-arcade",
  "version": "0.1.0",
  "private": true,
  "description": "Controller-first Raspberry Pi 5 arcade launcher",
  "main": "dist-electron/electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "tsc -b && vite build && npm run build:electron",
    "build:electron": "tsc -p tsconfig.electron.json",
    "package:pi": "npm run build && electron-builder --linux AppImage --arm64",
    "package:pi:dir": "npm run build && electron-builder --linux dir --arm64",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings=0"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "latest",
    "cross-env": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "eslint": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vitest": "latest",
    "wait-on": "latest"
  },
  "build": {
    "appId": "local.piarcade.launcher",
    "productName": "Pi Arcade",
    "files": ["dist/**", "dist-electron/**", "assets/**"],
    "linux": { "target": ["AppImage"], "category": "Game", "executableName": "pi-arcade" }
  }
}

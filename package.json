{
  "name": "pi-arcade",
  "version": "0.1.0",
  "private": true,
  "description": "Controller-first Raspberry Pi 5 arcade launcher",
  "main": "dist-electron/electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "tsc -b && vite build && npm run build:electron",
    "build:electron": "tsc -p tsconfig.electron.json",
    "package:pi": "npm run build && electron-builder --linux AppImage --arm64",
    "package:pi:dir": "npm run build && electron-builder --linux dir --arm64",
    "test": "vitest run tests",
    "test:e2e": "npm run build && playwright test",
    "test:watch": "vitest",
    "verify:content": "node scripts/verify-content.mjs",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings=0"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@playwright/test": "^1.64.1",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "latest",
    "cross-env": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "eslint": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vitest": "latest",
    "wait-on": "latest"
  },
  "build": {
    "appId": "local.piarcade.launcher",
    "productName": "Pi Arcade",
    "files": [
      "dist/**",
      "dist-electron/**",
      "electron/preload.cjs",
      "assets/**",
      "content/**"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "executableName": "pi-arcade"
    }
  }
}
